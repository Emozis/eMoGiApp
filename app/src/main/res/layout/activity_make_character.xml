<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".views.makecharacter.MakeCharacterActivity">

        <com.meta.emogi.views.toolbar.ToolbarView
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintHeight_percent="0.1"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 탭 레이아웃 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_tabs"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@color/bg_toolbar"
            app:layout_constraintHeight_percent="0.08"
            app:layout_constraintTop_toBottomOf="@id/toolbar">

            <ImageView
                android:id="@+id/require_front_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:background="@drawable/drawable_maker_tab_required"
                app:layout_constraintBottom_toBottomOf="@+id/tab_content"
                app:layout_constraintEnd_toStartOf="@+id/tab_content"
                app:layout_constraintTop_toTopOf="@+id/tab_content" />

            <TextView
                android:id="@+id/tab_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:text="내용"
                android:textColor="@color/white"
                android:textSize="@dimen/common_text_size_medium"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/tab_intro"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/require_front_intro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:background="@drawable/drawable_maker_tab_required"
                app:layout_constraintBottom_toBottomOf="@+id/tab_content"
                app:layout_constraintEnd_toStartOf="@+id/tab_intro"
                app:layout_constraintTop_toTopOf="@+id/tab_content" />

            <TextView
                android:id="@+id/tab_intro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:text="인트로"
                android:textColor="@color/gray"
                android:textSize="@dimen/common_text_size_medium"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/tab_situation"
                app:layout_constraintStart_toEndOf="@id/tab_content"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tab_situation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:text="상황예시"
                android:textColor="@color/gray"
                android:textSize="@dimen/common_text_size_medium"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/tab_introduce"
                app:layout_constraintStart_toEndOf="@id/tab_intro"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tab_introduce"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:text="캐릭터소개"
                android:textColor="@color/gray"
                android:textSize="@dimen/common_text_size_medium"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/tab_situation"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 탭 인디케이터 -->
        <View
            android:id="@+id/tab_indicator"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:background="@color/gray"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layout_tabs" />

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/fragmentContainerView5"
            android:name="androidx.navigation.fragment.NavHostFragment"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:defaultNavHost="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tab_indicator"
            app:navGraph="@navigation/make_character_nav" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>