<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="character"
            type="com.meta.emogi.data.network.model.CharacterResponse" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/item_menu_character"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/common_space_small"
        android:paddingStart="@dimen/common_space_semi_medium"
        android:paddingEnd="@dimen/common_space_medium"
        >

        <ImageView
            android:id="@+id/character_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@mipmap/ic_launcher"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/text_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/character_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="left"
                android:maxLines="1"
                android:paddingStart="@dimen/common_space_small"
                android:paddingEnd="@dimen/common_space_small"
                android:text="hihi"
                android:textColor="@color/white"
                android:textSize="@dimen/common_text_size_medium"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"
                app:layout_constraintBottom_toTopOf="@+id/character_description"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/character_description"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/common_space_small"
                android:ellipsize="end"
                android:maxLines="2"
                android:paddingStart="@dimen/common_space_small"
                android:paddingEnd="@dimen/common_space_small"
                android:text="설명설명\ndw\ndw"
                android:textColor="@color/white"
                android:textSize="@dimen/common_text_size_very_small"
                android:layout_marginBottom="4dp"
                app:layout_constraintBottom_toTopOf="@+id/character_tag"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/character_tag"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/common_space_small"
                android:ellipsize="end"
                android:maxLines="2"
                android:paddingStart="@dimen/common_space_small"
                android:paddingEnd="@dimen/common_space_small"
                android:text="#태그태그"
                android:textColor="@color/white"
                android:textSize="@dimen/common_text_size_very_small"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>



    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>