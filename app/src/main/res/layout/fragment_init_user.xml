<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="viewModel"
            type="com.meta.emogi.views.login.inituser.InitUserViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_back"
            app:tint="@android:color/white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="회원가입"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/btn_back"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/btn_back" />

        <TextView
            android:id="@+id/tv_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="MAMUZ에서 사용할 이름을 적어주세요"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btn_back" />

        <TextView
            android:id="@+id/tv_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="대화할 때 사용할 프로필을 만들어보세요\n나중에도 수정할 수 있어요"
            android:textColor="#888888"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_subtitle" />

        <TextView
            android:id="@+id/tv_name_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="이름"
            android:textColor="#AAAAAA"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_description" />

        <EditText
            android:id="@+id/et_name"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_edittext"
            android:hint="이름을 입력하세요"
            android:textColor="@android:color/white"
            android:textColorHint="#555555"
            android:paddingHorizontal="16dp"
            android:text="@={viewModel.userName}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_name_label" />
            
        <TextView
            android:id="@+id/tv_birth_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="생년월일"
            android:textColor="#AAAAAA"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/et_name" />

        <EditText
            android:id="@+id/et_year"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_edittext"
            android:hint="YYYY"
            android:textColor="@android:color/white"
            android:textColorHint="#555555"
            android:paddingHorizontal="16dp"
            android:gravity="center_vertical|start"
            android:inputType="number"
            android:maxLength="4"
            android:text="@={viewModel.birthYear}"
            app:layout_constraintEnd_toStartOf="@+id/et_month"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_birth_label"
            app:layout_constraintHorizontal_weight="2"
            android:layout_marginEnd="8dp"/>
            
        <EditText
            android:id="@+id/et_month"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:background="@drawable/bg_edittext"
            android:hint="MM"
            android:textColor="@android:color/white"
            android:textColorHint="#555555"
            android:paddingHorizontal="16dp"
            android:gravity="center_vertical|start"
            android:inputType="number"
            android:maxLength="2"
            android:text="@={viewModel.birthMonth}"
            app:layout_constraintEnd_toStartOf="@+id/et_day"
            app:layout_constraintStart_toEndOf="@+id/et_year"
            app:layout_constraintTop_toTopOf="@+id/et_year" 
            app:layout_constraintHorizontal_weight="1"
            android:layout_marginEnd="8dp"/>

         <EditText
            android:id="@+id/et_day"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:background="@drawable/bg_edittext"
            android:hint="DD"
            android:textColor="@android:color/white"
            android:textColorHint="#555555"
            android:paddingHorizontal="16dp"
            android:gravity="center_vertical|start"
            android:inputType="number"
            android:maxLength="2"
            android:text="@={viewModel.birthDay}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/et_month"
            app:layout_constraintTop_toTopOf="@+id/et_year" 
            app:layout_constraintHorizontal_weight="1"/>   

        <TextView
            android:id="@+id/tv_gender_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="성별"
            android:textColor="#AAAAAA"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/et_year" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_male"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="4dp"
            android:text="남성"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_gender_selector"
            android:backgroundTint="@{viewModel.isMale == true ? @color/main_purple : @color/login_btn_bg}"
            android:gravity="center_vertical|start"
            android:paddingStart="16dp"
            android:onClick="@{() -> viewModel.setGender(true)}"
            app:layout_constraintEnd_toStartOf="@+id/btn_female"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_gender_label" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_female"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:layout_marginStart="4dp"
            android:text="여성"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_gender_selector"
            android:backgroundTint="@{viewModel.isMale == false ? @color/main_purple: @color/login_btn_bg}"
            android:gravity="center_vertical|start"
            android:paddingStart="16dp"
            android:onClick="@{() -> viewModel.setGender(false)}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/btn_male"
            app:layout_constraintTop_toBottomOf="@+id/tv_gender_label" />

        <Button
            android:id="@+id/btn_complete"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginBottom="24dp"
            android:text="동의하기"
            android:textSize="16sp"
            android:backgroundTint="@color/main_purple"
            android:onClick="@{() -> viewModel.onCompleteClick()}"
            android:enabled="@{viewModel.isFormValid}"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>